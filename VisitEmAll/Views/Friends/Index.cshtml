@model VisitEmAll.Models.ViewModels.FriendsViewModel

@{
  ViewData["Title"] = "Friends";
}

<div class="friend-container">
  <h1 class="friend-page-title">My Friends</h1>

  <div class="friend-layout-grid">

    <aside class="friend-sidebar">

      <section class="friend-section">
        <h4 class="friend-section-title">Friend Requests (@Model.PendingRequests.Count)</h4>
        @if (!Model.PendingRequests.Any())
        {
          <p class="friend-empty-state">No new requests</p>
        }

        @foreach (var request in Model.PendingRequests)
        {
          <div class="friend-card friend-card--request">
            <div class="friend-card-content">
              <div class="friend-info">
                <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(request.Requester.Name)"
                     class="friend-avatar" alt="Avatar">
                <span class="friend-name friend-name--truncate">@request.Requester.Name</span>
              </div>
              <div class="friend-actions">
                <form asp-action="Accept" method="post">
                  <input type="hidden" name="id" value="@request.Id" />
                  <button type="submit" class="friend-btn friend-btn--primary">Accept</button>
                </form>
                <form asp-action="Reject" method="post">
                  <input type="hidden" name="id" value="@request.Id" />
                  <button type="submit" class="friend-btn friend-btn--outline-danger">Reject</button>
                </form>
              </div>
            </div>
          </div>
        }
      </section>

      <section class="friend-section friend-section--divider">
        <h4 class="friend-section-title">Sent Requests (@Model.SentRequests.Count)</h4>
        @if (!Model.SentRequests.Any())
        {
          <p class="friend-empty-state">You have no active requests.</p>
        }

        @foreach (var request in Model.SentRequests)
        {
          <div class="friend-card friend-card--sent">
            <div class="friend-card-content">
              <div class="friend-info">
                <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(request.Receiver.Name)"
                     class="friend-avatar" alt="Avatar">
                <span class="friend-name friend-name--truncate">@request.Receiver.Name</span>
              </div>
              <span class="friend-badge">Pending</span>
            </div>
          </div>
        }
      </section>

      <section class="friend-section friend-section--divider">
        <h4 class="friend-section-title">Find New Friends</h4>
        <div class="friend-list-vertical">
          @foreach (var user in Model.AllOtherUsers)
          {
            <div class="friend-card friend-card--suggested">
              <div class="friend-card-content">
                <div class="friend-info">
                  <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(user.Name)&background=random"
                       class="friend-avatar friend-avatar--lg" alt="Avatar">
                  <strong class="friend-name">@user.Name</strong>
                </div>

                <form asp-action="SendRequest" method="post">
                  <input type="hidden" name="receiverId" value="@user.Id" />
                  <button type="submit" class="friend-btn friend-btn--primary">Add Friend</button>
                </form>
              </div>
            </div>
          }
        </div>
      </section>
    </aside>

    <main class="friend-main">
      <h4 class="friend-section-title">My Friends (@Model.AcceptedFriends.Count)</h4>
      <div class="friend-list-vertical">
        @if (!Model.AcceptedFriends.Any())
        {
          <p class="friend-empty-state">You haven't added any friends yet.</p>
        }

        @foreach (var friend in Model.AcceptedFriends)
        {
          <div class="friend-card friend-card--accepted">
            <div class="friend-card-content">
              <div class="friend-info">
                <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(friend.Name)&background=random"
                     class="friend-avatar friend-avatar--lg" alt="Avatar">
                <a asp-controller="Dashboard" asp-action="Index" asp-route-id="@friend.Id" class="friend-link">
                  <strong>@friend.Name</strong>
                </a>
              </div>

              <div class="friend-actions">
                <form asp-action="Remove" method="post">
                  <input type="hidden" name="id" value="@friend.Id" />
                  <button type="submit" class="friend-btn friend-btn--outline-muted"
                          onclick="return confirm('Are you sure you want to remove @friend.Name?')">
                    Remove
                  </button>
                </form>
              </div>
            </div>
          </div>
        }
      </div>
    </main>

  </div>
</div>