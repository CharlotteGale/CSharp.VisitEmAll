@section Styles {
    <link rel="stylesheet" href="~/css/details.css" />
}

@using VisitEmAll.ViewModels
@model HolidayDetailsViewModel
@using Microsoft.AspNetCore.Http

@inject IHttpContextAccessor HttpContextAccessor
@{
    var currentUserId = HttpContextAccessor.HttpContext?.Session.GetInt32("User_Id");
}

<div class="container py-4">
    <!-- TITLE & LOCATION -->
    @if (!string.IsNullOrEmpty(Model.Location))
    {
        <h1 class="details-title">@Model.Title</h1>
        <p class="details-location">@Model.Location</p>
    }
    <div class="row g-4 mb-4">
        <!-- HERO BANNER -->
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.HeroImageUrl))
            {
                <div class="hero-image">
                    <img src="@Model.HeroImageUrl" alt="Hero Image" />
                </div>
            }
        </div>
        <!-- TRIP SUMMARY -->
        <div class="col-md-6">
            <div class="summary-card card-summary p-4">
                <h2>Trip Summary</h2>
                <p><strong>Location:</strong> @Model.Location</p>
                <p><strong>Plan:</strong> @Model.Days.Count Day Itinerary</p>
                @if (Model.StartDate.HasValue || Model.EndDate.HasValue)
                {
                    <p><strong>Dates:</strong>
                        @Model.StartDate?.ToString("dd MMMM yyyy")
                        @if (Model.StartDate.HasValue && Model.EndDate.HasValue)
                        {
                            @(" - ")
                        }
                        @Model.EndDate?.ToString("dd MMMM yyyy")
                    </p>
                }
                @if (Model.TotalCost.HasValue)
                {
                    <p><strong>Total Cost:</strong> £@Model.TotalCost.Value.ToString("0.00")</p>
                }
            </div>
        </div>
    </div>
</div>


<h1 class="details-title">Itinerary</h1>
    <!-- DAY SECTIONS -->
    @foreach (var day in Model.Days)
    {
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="section-card card-itinerary p-4">
                    <h3>@day.Date.ToString("dddd, dd MMM yyyy")</h3>
                    <!-- ADD BUTTONS -->
                    @if (currentUserId == Model.OwnerUserId)
                    {
                    <div class="mb-3">
                    <a asp-action="Details"
                    asp-route-id="@Model.HolidayId"
                    asp-route-addType="Activity"
                    asp-route-dayId="@day.DayId"
                    class="btn btn-sm btn-add-activity">
                        Add Activity
                    </a>
                    <a asp-action="Details"
                    asp-route-id="@Model.HolidayId"
                    asp-route-addType="Restaurant"
                    asp-route-dayId="@day.DayId"
                    class="btn btn-sm btn-add-restaurant">
                        Add Restaurant
                    </a>
                    <a asp-action="Details"
                    asp-route-id="@Model.HolidayId"
                    asp-route-addType="Accommodation"
                    asp-route-dayId="@day.DayId"
                    class="btn btn-sm btn-add-accommodation">
                        Add Accommodation
                    </a>
                        </div>
                    }
                    <!-- INLINE ADD FORM -->
                    @if (Model.AddDayId == day.DayId)
                    {
                        if (Model.AddType == "Activity")
                        {
                            <form asp-controller="DayItems"
                                    asp-action="CreateActivity"
                                    asp-route-dayId="@day.DayId"
                                    method="post"
                                    class="border p-3 rounded mb-3">
                                <h5>Add Activity</h5>
                                <div class="mb-2">
                                    <label>Name</label>
                                    <input class="form-control" name="Name" required />
                                </div>
                                <div class="mb-2">
                                    <label>Time</label>
                                    <input class="form-control" type="time" name="Time" />
                                </div>
                                <div class="mb-2">
                                    <label>Location</label>
                                    <input class="form-control" name="Location" />
                                </div>
                                <div class="mb-2">
                                    <label>Notes</label>
                                    <textarea class="form-control" name="Notes"></textarea>
                                </div>
                                <button class="btn btn-success btn-sm">Save</button>
                                <a asp-action="Details"
                                    asp-route-id="@Model.HolidayId"
                                    class="btn btn-secondary btn-sm">
                                    Cancel
                                </a>
                            </form>
                        }
                        if (Model.AddType == "Restaurant")
                        {
                            <form asp-controller="DayItems"
                                    asp-action="CreateRestaurant"
                                    asp-route-dayId="@day.DayId"
                                    method="post"
                                    class="border p-3 rounded mb-3">
                                <h5>Add Restaurant</h5>
                                <div class="mb-2">
                                    <label>Name</label>
                                    <input class="form-control" name="Name" required />
                                </div>
                                <div class="mb-2">
                                    <label>Time</label>
                                    <input class="form-control" type="time" name="Time" />
                                </div>
                                <div class="mb-2">
                                    <label>Location</label>
                                    <input class="form-control" name="Location" />
                                </div>
                                <div class="mb-2">
                                    <label>Notes</label>
                                    <textarea class="form-control" name="Notes"></textarea>
                                </div>
                                <button class="btn btn-success btn-sm">Save</button>
                                <a asp-action="Details"
                                    asp-route-id="@Model.HolidayId"
                                    class="btn btn-secondary btn-sm">
                                    Cancel
                                </a>
                            </form>
                        }
                        if (Model.AddType == "Accommodation")
                        {
                            <form asp-controller="DayItems"
                                    asp-action="CreateAccommodation"
                                    asp-route-dayId="@day.DayId"
                                    method="post"
                                    class="border p-3 rounded mb-3">
                                <h5>Add Accommodation</h5>
                                <div class="mb-2">
                                    <label>Name</label>
                                    <input class="form-control" name="Name" required />
                                </div>
                                <div class="mb-2">
                                    <label>Time</label>
                                    <input class="form-control" type="time" name="Time" />
                                </div>
                                <div class="mb-2">
                                    <label>Location</label>
                                    <input class="form-control" name="Location" />
                                </div>
                                <div class="mb-2">
                                    <label>Notes</label>
                                    <textarea class="form-control" name="Notes"></textarea>
                                </div>
                                <button class="btn btn-success btn-sm">Save</button>
                                <a asp-action="Details"
                                    asp-route-id="@Model.HolidayId"
                                    class="btn btn-secondary btn-sm">
                                    Cancel
                                </a>
                            </form>
                        }
                    }
                    <!-- TIMELINE -->
                    @if (!day.Items.Any())
                    {
                        <p>No items planned for this day.</p>
                    }
                    else
                    {
                        <ul class="timeline">
                            @foreach (var item in day.Items)
                            {
                            <li class="timeline-item">
                                @{
                                    var editing = TempData["EditingItemId"] != null &&
                                                (int)TempData["EditingItemId"] == item.Id;
                                }
                                @if (!editing)
                                {
                                    <!-- DISPLAY MODE -->
                                    <span class="time">@((item.Time?.ToString("HH:mm") ?? "--:--"))</span>
                                    <span class="item-title">@item.Name</span>
                                    <span class="item-type">(@item.ItemType)</span>
                                    @if (!string.IsNullOrEmpty(item.Location))
                                    {
                                        <span class="location"> - @item.Location</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <div class="notes">@item.Notes</div>
                                    }
                                    @if (currentUserId == Model.OwnerUserId)
                                    {
                                        <div class="item-actions mt-2">
                                            <!-- EDIT BUTTON -->
                                            <form method="post"
                                                asp-controller="DayItems"
                                                asp-action="EditInline"
                                                asp-route-id="@item.Id"
                                                class="d-inline">
                                                <button type="submit" class="btn btn-outline-dark btn-sm me-2">Edit</button>
                                            </form>
                                            <!-- DELETE BUTTON -->
                                            <form asp-controller="DayItems"
                                                asp-action="DeleteItem"
                                                asp-route-id="@item.Id"
                                                method="post"
                                                class="d-inline">
                                                <button class="btn btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('Delete this item?');">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <form asp-controller="DayItems"
                                        asp-action="UpdateItem"
                                        asp-route-id="@item.Id"
                                        method="post"
                                        class="edit-inline-form mt-2 d-inline">
                                        <div class="row g-2">
                                            <div class="col-3">
                                                <input type="time" name="time" value="@item.Time" class="form-control form-control-sm" />
                                            </div>
                                            <div class="col-3">
                                                <input type="text" name="name" value="@item.Name" placeholder="Name" class="form-control form-control-sm" />
                                            </div>
                                            <div class="col-3">
                                                <input type="text" name="location" value="@item.Location" placeholder="Location" class="form-control form-control-sm" />
                                            </div>
                                            <div class="col-3">
                                                <input type="text" name="notes" value="@item.Notes" placeholder="Notes" class="form-control form-control-sm"/>
                                            </div>
                                        </div>
                                        <button type="submit" class="btn btn-success btn-sm mt-2 me-2">Save</button>
                                    </form>
                                    <form method="post"
                                        asp-controller="DayItems"
                                        asp-action="CancelInline"
                                        asp-route-id="@item.Id"
                                        class="d-inline">
                                        <button type="submit" class="btn btn-outline-dark btn-sm mt-2">Cancel</button>
                                    </form>
                                }
                            </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
        
    }
            
    
    
    
    <!-- PHOTOS -->
<h1 class="details-title">Photos</h1>
    <div class="row mb-4">
        <div class="col-12">
            <div class="section-card card-itinerary p-4 rounded">
                <div class="photo-placeholder">[INSERT PHOTOS HERE]</div>
            </div>
        </div>
    </div>
    <!-- OWNER ACTIONS -->
    @if (currentUserId == Model.OwnerUserId)
    {
        <div class="mt-4">
            <a asp-action="EditHoliday" asp-route-id="@Model.HolidayId" class="btn btn-success me-2">Edit Holiday</a>
            <form asp-action="DeleteHoliday" asp-route-id="@Model.HolidayId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"
                        onclick="return confirm('Are you sure you want to delete this holiday?');">
                    Remove Holiday
                </button>
            </form>
        </div>
    }
</div>
