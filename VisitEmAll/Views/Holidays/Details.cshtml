@section Styles {
    <link rel="stylesheet" href="~/css/details.css" />
}

@using VisitEmAll.ViewModels
@model HolidayDetailsViewModel
@using Microsoft.AspNetCore.Http

@inject IHttpContextAccessor HttpContextAccessor

@{
    var currentUserId = HttpContextAccessor.HttpContext?.Session.GetInt32("User_Id");
}

<div class="details-container">

    <h1 class="details-title">@Model.Title</h1>

    @if (!string.IsNullOrEmpty(Model.Location))
    {
        <p class="details-location">@Model.Location</p>
    }

    <!-- ROW 1: SUMMARY + ACTIVITIES -->
    <div class="summary-grid">

        <!-- Summary -->
        <div class="summary-card">
            <h2>Trip Summary</h2>

            <p><strong>Plan:</strong> @Model.Days.Count Day Itinerary</p>

            @if (Model.StartDate.HasValue && Model.EndDate.HasValue)
            {
                <p><strong>Dates:</strong> @Model.StartDate.Value.ToString("dd MMM yyyy") -
                    @Model.EndDate.Value.ToString("dd MMM yyyy")</p>
            }

            @if (!string.IsNullOrEmpty(Model.Accommodation))
            {
                <p><strong>Accommodation:</strong> @Model.Accommodation</p>
            }

            @if (Model.TotalCost.HasValue)
            {
                <p><strong>Total Cost:</strong> £@Model.TotalCost.Value.ToString("0.00")</p>
            }
        </div>

        <!-- Activities -->
        <div class="section-card">
            <h2>Activities</h2>
            <ul class="activity-list">
                @foreach (var day in Model.Days)
                {
                    foreach (var item in day.Items.Where(i => i.ItemType == "Activity"))
                    {
                        <li>@item.Name</li>
                    }
                }
            </ul>
        </div>

    </div>


    <!-- ROW 2: ITINERARY DAY 1 + MAP -->
    @if (Model.Days.Count > 0)
    {
        var day1 = Model.Days[0];

        <div class="row-grid">
            <!-- Day 1 -->
            <div class="section-card">
                <h3>@day1.Date.ToString("dddd, dd MMM yyyy")</h3>

                @if (!day1.Items.Any())
                {
                    <p>No items planned for this day.</p>
                }
                else
                {
                    <ul class="timeline">
                        @foreach (var item in day1.Items)
                        {
                            <li class="timeline-item">
                                <span class="time">@((item.Time?.ToString("HH:mm") ?? "--:--"))</span>
                                <span class="item-title">@item.Name</span>
                                <span class="item-type">(@item.ItemType)</span>

                                @if (!string.IsNullOrEmpty(item.Location))
                                {
                                    <span class="location"> - @item.Location</span>
                                }

                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <div class="notes">@item.Notes</div>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>

            <!-- Map -->
            <div class="map-card">
                <div class="map-placeholder">[INSERT MAP HERE]</div>
            </div>
        </div>
    }


    <!-- ROW 3: ITINERARY DAY 2 + TRAVEL TIPS -->
    @if (Model.Days.Count > 1)
    {
        var day2 = Model.Days[1];

        <div class="row-grid">
            <!-- Day 2 -->
            <div class="section-card">
                <h3>@day2.Date.ToString("dddd, dd MMM yyyy")</h3>

                @if (!day2.Items.Any())
                {
                    <p>No items planned for this day.</p>
                }
                else
                {
                    <ul class="timeline">
                        @foreach (var item in day2.Items)
                        {
                            <li class="timeline-item">
                                <span class="time">@((item.Time?.ToString("HH:mm") ?? "--:--"))</span>
                                <span class="item-title">@item.Name</span>
                                <span class="item-type">(@item.ItemType)</span>

                                @if (!string.IsNullOrEmpty(item.Location))
                                {
                                    <span class="location"> - @item.Location</span>
                                }

                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <div class="notes">@item.Notes</div>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>

            <!-- Travel Tips -->
            <div class="section-card">
                <h2>Travel Tips</h2>
                <ul class="tips-list">
                    <li>Lorem ipsum dolor sit amet consectetur adipiscing elit.</li>
                    <li>Consectetur adipiscing elit quisque.</li>
                    <li>Ex sapien vitae pellentesque sem.</li>
                    <li>Placerat in id cursus mi pretium duis.</li>
                    <li>Pretium tellus duis convallis tempus leo eu aenean.</li>
                </ul>
            </div>
        </div>
    }


    <!-- ROW 4: ITINERARY DAY 3 (FULL WIDTH) -->
    @if (Model.Days.Count > 2)
    {
        var day3 = Model.Days[2];

        <div class="full-width section-card">
            <h3>@day3.Date.ToString("dddd, dd MMM yyyy")</h3>

            @if (!day3.Items.Any())
            {
                <p>No items planned for this day.</p>
            }
            else
            {
                <ul class="timeline">
                    @foreach (var item in day3.Items)
                    {
                        <li class="timeline-item">
                            <span class="time">@((item.Time?.ToString("HH:mm") ?? "--:--"))</span>
                            <span class="item-title">@item.Name</span>
                            <span class="item-type">(@item.ItemType)</span>

                            @if (!string.IsNullOrEmpty(item.Location))
                            {
                                <span class="location"> - @item.Location</span>
                            }

                            @if (!string.IsNullOrEmpty(item.Notes))
                            {
                                <div class="notes">@item.Notes</div>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }


    <!-- PHOTOS -->
    <div class="section-card">
        <h2>Photos</h2>
        <div class="photo-placeholder">[INSERT PHOTOS HERE]</div>
    </div>


    <!-- OWNER ACTIONS -->
    @if (currentUserId == Model.OwnerUserId)
    {
        <div class="owner-actions">
            <a asp-action="EditHoliday" asp-route-id="@Model.HolidayId" class="btn btn-success">Edit Holiday</a>

            <form asp-action="Delete" asp-route-id="@Model.HolidayId" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"
                        onclick="return confirm('Are you sure you want to delete this holiday?');">
                    Remove Holiday
                </button>
            </form>
        </div>
    }

</div>
