@using System.Linq
@model VisitEmAll.ViewModels.CreateHolidayViewModel

@{
    ViewData["Title"] = "Add Holiday";
}

<h1 class="details-title">Create a New Holiday</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <!-- HERO UPLOAD CARD -->
        <div class="card hero-upload-card mb-4" style="position:relative;">

            <div class="hero-upload-inner" style="position:absolute; z-index:10; width:100%; text-align:center;">
                <button type="button" class="hero-upload-btn"
                        onclick="document.getElementById('HeroImageFile').click();">
                    + Add Banner Image
                </button>
                <input asp-for="HeroImageFile" id="HeroImageFile" type="file" accept="image/*" hidden />
            </div>

            <img id="hero-preview"
                src=""
                alt="Banner Preview"
                style="display:none; width:100%; height:100%; object-fit:cover; border-radius:16px;" />

        </div>



    <div class="row g-4 mb-4">

        <div class="col-md-8">
            <div class="summary-card-flex p-4">
                <h2>Trip Summary</h2>

                <div class="mb-3">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Location"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <!-- COUNTRY -->
                <div class="mb-3">
                    <label for="country-search">Country</label>

                    <input id="country-search"
                           type="text"
                           autocomplete="off"
                           class="form-control"
                           placeholder="Start typing a country… (e.g. Japan)"
                           value="@(Model.CountryName ?? "")" />

                    <input asp-for="CountryId" type="hidden" id="CountryId" />
                    <span asp-validation-for="CountryId" class="text-danger"></span>

                    <div style="position:relative;">
                        <div id="country-results"
                             style="display:none; position:absolute; left:0; right:0; z-index:50;
                                    border:1px solid #ddd; border-radius:10px; margin-top:6px;
                                    overflow:hidden; background:white; max-height:240px; overflow-y:auto;">
                        </div>
                    </div>

                    <small class="text-muted">Pick a real country from the list so your travel stats + map can update automatically.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="StartDate"></label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndDate"></label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TotalCost"></label>
                    <input asp-for="TotalCost" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="TotalCost" class="text-danger"></span>
                </div>

            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Create Holiday</button>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Cancel</a>

    <div asp-validation-summary="All" class="text-danger mt-3"></div>
</form>

@section Styles {
    <link rel="stylesheet" href="~/css/details.css" />

    <style>
        .hero-upload-card {
            height: 260px;
            border-radius: 16px;
            overflow: hidden;
            background: #f3e7c9;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-upload-inner {
            text-align: center;
        }

        .hero-upload-btn {
            background: rgba(255,255,255,0.85);
            padding: 14px 22px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            border: 1px solid #ddd;
            transition: 0.2s;
        }

        .hero-upload-btn:hover {
            background: white;
            transform: scale(1.03);
        }
        .summary-card-flex {
            border-radius: 16px;
            background: linear-gradient(
                to bottom,
                #fcf2dcdf 50%,
                #f5e4c2 100%,
                #f7e1b0cd 100%
            );
            padding: 24px;
            width: 100%;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Add activity rows dynamically (server validation still applies; client-side validation for new rows is not wired by default)
        (function () {
            const container = document.getElementById("activities");
            const addBtn = document.getElementById("add-activity");

            addBtn.addEventListener("click", () => {
                const index = container.querySelectorAll(".activity-row").length;
                const row = document.createElement("div");
                row.className = "activity-row";
                row.innerHTML = `
                    <label>Activity name</label>
                    <input name="Activities[${index}].Name" placeholder="e.g. Museum visit" />
                `;
                container.appendChild(row);
            });
        })();
    </script>

    <script>
        // Country typeahead -> sets hidden CountryId from /countries/search?q=
        (function () {
            const input = document.getElementById("country-search");
            const hidden = document.getElementById("CountryId");
            const results = document.getElementById("country-results");

            if (!input || !hidden || !results) return;

            let abortController = null;
            let selectedName = (input.value || "").trim();

            function show() { results.style.display = "block"; }
            function hide() { results.style.display = "none"; }
            function clearResults() { results.innerHTML = ""; }

            function escapeHtml(str) {
                return String(str).replace(/[&<>"']/g, m => ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#039;"
                }[m]));
            }

            function clearSelectionIfUserTyped() {
                // If user edits the text after selecting, invalidate the hidden id
                if ((input.value || "").trim() !== selectedName) {
                    hidden.value = "";
                }
            }

            function renderItems(items) {
                clearResults();

                if (!items || items.length === 0) {
                    results.innerHTML = `<div style="padding:10px; color:#666;">No matches</div>`;
                    show();
                    return;
                }

                for (const c of items) {
                    const row = document.createElement("button");
                    row.type = "button";
                    row.style.cssText =
                        "width:100%; text-align:left; padding:10px 12px; border:0; background:white; cursor:pointer;";

                    row.onmouseenter = () => row.style.background = "#f6f6f6";
                    row.onmouseleave = () => row.style.background = "white";

                    row.innerHTML = `
                        <div style="font-weight:600;">${escapeHtml(c.name)}</div>
                        <div style="font-size:12px; color:#666;">
                            ${escapeHtml(c.continent ?? "")}${c.iso2 ? " • " + escapeHtml(c.iso2) : ""}
                        </div>
                    `;

                    row.addEventListener("click", () => {
                        input.value = c.name;
                        selectedName = c.name;
                        hidden.value = c.id;
                        hide();
                    });

                    results.appendChild(row);
                }

                show();
            }

            async function search(q) {
                if (abortController) abortController.abort();
                abortController = new AbortController();

                const res = await fetch(`/countries/search?q=${encodeURIComponent(q)}`, {
                    signal: abortController.signal,
                    headers: { "Accept": "application/json" }
                });

                if (!res.ok) return [];
                return await res.json();
            }

            let timer = null;

            input.addEventListener("input", () => {
                clearSelectionIfUserTyped();

                const q = (input.value || "").trim();

                if (timer) clearTimeout(timer);

                if (q.length === 0) {
                    hidden.value = "";
                    selectedName = "";
                    hide();
                    clearResults();
                    return;
                }

                timer = setTimeout(async () => {
                    try {
                        const items = await search(q);
                        renderItems(items);
                    } catch (e) {
                        // fetch aborted = ignore
                    }
                }, 120);
            });

            input.addEventListener("focus", () => {
                // if there's content already, show current results container (if populated)
                if (results.innerHTML.trim() !== "") show();
            });

            document.addEventListener("click", (e) => {
                if (!results.contains(e.target) && e.target !== input) hide();
            });

            // If already selected (useful for Edit), preserve selection
            if (hidden.value && selectedName.length > 0) {
                // keep as-is
            }
        })();
    </script>

        <script>
        document.getElementById("HeroImageFile").addEventListener("change", function () {
            const file = this.files[0];
            const preview = document.getElementById("hero-preview");

            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = "block";
                };
                reader.readAsDataURL(file);
            }
        });
        </script>


}