@using System.Linq
@model VisitEmAll.ViewModels.CreateHolidayViewModel

@{
    ViewData["Title"] = "Add Holiday";
}

<h1>Add Holiday</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" />
        <span asp-validation-for="Title"></span>
    </div>

    <div>
        <label asp-for="Location"></label>
        <input asp-for="Location" />
        <span asp-validation-for="Location"></span>
    </div>

    <!-- Country (typeahead + hidden CountryId) -->
    <div>
        <label for="country-search">Country</label>

        <input id="country-search"
               type="text"
               autocomplete="off"
               placeholder="Start typing a country… (e.g. Japan)"
               value="@(Model.CountryName ?? "")" />

        <input asp-for="CountryId" type="hidden" id="CountryId" />
        <span asp-validation-for="CountryId"></span>

        <!-- Results dropdown (absolute so it doesn't push layout) -->
        <div style="position:relative;">
            <div id="country-results"
                 style="display:none; position:absolute; left:0; right:0; z-index:50;
                        border:1px solid #ddd; border-radius:10px; margin-top:6px;
                        overflow:hidden; background:white; max-height:240px; overflow-y:auto;">
            </div>
        </div>

        <small style="display:block; margin-top:6px; color:#666;">
            Pick a real country from the list so your travel stats + map can update automatically.
        </small>
    </div>

    <div>
        <label asp-for="StartDate"></label>
        <input asp-for="StartDate" type="date" />
        <span asp-validation-for="StartDate"></span>
    </div>

    <div>
        <label asp-for="EndDate"></label>
        <input asp-for="EndDate" type="date" />
        <span asp-validation-for="EndDate"></span>
    </div>


    <div>
        <label asp-for="TotalCost"></label>
        <input asp-for="TotalCost" type="number" step="0.01" />
        <span asp-validation-for="TotalCost"></span>
    </div>

    <div>
        <label asp-for="ThumbnailUrl">Thumbnail (URL or path)</label>
        <input asp-for="ThumbnailUrl" />
        <span asp-validation-for="ThumbnailUrl"></span>
    </div>

    <h3>Activities</h3>

    <div id="activities">
        @for (var i = 0; i < (Model.Activities?.Count ?? 0); i++)
        {
            <div class="activity-row">
                <label>Activity name</label>
                <input asp-for="Activities[i].Name" placeholder="e.g. Horse riding" />
                <span asp-validation-for="Activities[i].Name"></span>
            </div>
        }
    </div>

    <button type="button" id="add-activity">+ Add another activity</button>

    <div>
        <button type="submit">Submit</button>
        <a asp-controller="Dashboard" asp-action="Index">Cancel</a>
    </div>

    <div asp-validation-summary="All"></div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Add activity rows dynamically (server validation still applies; client-side validation for new rows is not wired by default)
        (function () {
            const container = document.getElementById("activities");
            const addBtn = document.getElementById("add-activity");

            addBtn.addEventListener("click", () => {
                const index = container.querySelectorAll(".activity-row").length;
                const row = document.createElement("div");
                row.className = "activity-row";
                row.innerHTML = `
                    <label>Activity name</label>
                    <input name="Activities[${index}].Name" placeholder="e.g. Museum visit" />
                `;
                container.appendChild(row);
            });
        })();
    </script>

    <script>
        // Country typeahead -> sets hidden CountryId from /countries/search?q=
        (function () {
            const input = document.getElementById("country-search");
            const hidden = document.getElementById("CountryId");
            const results = document.getElementById("country-results");

            if (!input || !hidden || !results) return;

            let abortController = null;
            let selectedName = (input.value || "").trim();

            function show() { results.style.display = "block"; }
            function hide() { results.style.display = "none"; }
            function clearResults() { results.innerHTML = ""; }

            function escapeHtml(str) {
                return String(str).replace(/[&<>"']/g, m => ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#039;"
                }[m]));
            }

            function clearSelectionIfUserTyped() {
                // If user edits the text after selecting, invalidate the hidden id
                if ((input.value || "").trim() !== selectedName) {
                    hidden.value = "";
                }
            }

            function renderItems(items) {
                clearResults();

                if (!items || items.length === 0) {
                    results.innerHTML = `<div style="padding:10px; color:#666;">No matches</div>`;
                    show();
                    return;
                }

                for (const c of items) {
                    const row = document.createElement("button");
                    row.type = "button";
                    row.style.cssText =
                        "width:100%; text-align:left; padding:10px 12px; border:0; background:white; cursor:pointer;";

                    row.onmouseenter = () => row.style.background = "#f6f6f6";
                    row.onmouseleave = () => row.style.background = "white";

                    row.innerHTML = `
                        <div style="font-weight:600;">${escapeHtml(c.name)}</div>
                        <div style="font-size:12px; color:#666;">
                            ${escapeHtml(c.continent ?? "")}${c.iso2 ? " • " + escapeHtml(c.iso2) : ""}
                        </div>
                    `;

                    row.addEventListener("click", () => {
                        input.value = c.name;
                        selectedName = c.name;
                        hidden.value = c.id;
                        hide();
                    });

                    results.appendChild(row);
                }

                show();
            }

            async function search(q) {
                if (abortController) abortController.abort();
                abortController = new AbortController();

                const res = await fetch(`/countries/search?q=${encodeURIComponent(q)}`, {
                    signal: abortController.signal,
                    headers: { "Accept": "application/json" }
                });

                if (!res.ok) return [];
                return await res.json();
            }

            let timer = null;

            input.addEventListener("input", () => {
                clearSelectionIfUserTyped();

                const q = (input.value || "").trim();

                if (timer) clearTimeout(timer);

                if (q.length === 0) {
                    hidden.value = "";
                    selectedName = "";
                    hide();
                    clearResults();
                    return;
                }

                timer = setTimeout(async () => {
                    try {
                        const items = await search(q);
                        renderItems(items);
                    } catch (e) {
                        // fetch aborted = ignore
                    }
                }, 120);
            });

            input.addEventListener("focus", () => {
                // if there's content already, show current results container (if populated)
                if (results.innerHTML.trim() !== "") show();
            });

            document.addEventListener("click", (e) => {
                if (!results.contains(e.target) && e.target !== input) hide();
            });

            // If already selected (useful for Edit), preserve selection
            if (hidden.value && selectedName.length > 0) {
                // keep as-is
            }
        })();
    </script>
}